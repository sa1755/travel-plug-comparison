# Optional local canonical origin. Vercel deployments automatically use
# VERCEL_PROJECT_PRODUCTION_URL when this value is absent.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional privacy switch. Analytics is enabled by default in production.
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# Optional GA4 web-stream measurement ID. Leave blank to disable Google
# Analytics and its consent prompt. This identifier is public, not a secret.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
